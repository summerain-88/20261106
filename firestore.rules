rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Assumed data model (Standard edition, default database):
    // users/{uid}/categories/{categoryId}: id, uid, name (1-8 characters).
    // users/{uid}/tasks/{taskId}: id, uid, title, date, time, category, notes,
    //   reminderMinutes, reminderMethod, priority, completed.
    // users/{uid}/events/{eventId}: id, uid, title, date, time, endTime,
    //   category, notes, reminderMinutes, reminderMethod, location.
    // Each record is private to the authenticated user whose UID owns its path.

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isDocOwner() {
      return isAuthenticated() && resource.data.uid == request.auth.uid;
    }

    function uidUnchanged() {
      return request.resource.data.uid == request.auth.uid;
    }

    function uidNotModified() {
      return request.resource.data.uid == resource.data.uid;
    }

    function validId(data, pathId) {
      return data.id is string && data.id.size() > 0 && data.id.size() <= 100 && data.id == pathId;
    }

    function validUid(data) {
      return data.uid is string && data.uid.size() > 0 && data.uid.size() <= 128 && data.uid == request.auth.uid;
    }

    function validDate(data) {
      return data is string && data.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function validTime(data) {
      return data is string && (data == '' || data.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$'));
    }

    function validReminder(data) {
      return data == null || (data is int && data in [0, 5, 10, 15, 30, 60, 1440]);
    }

    function validCommonFields(data) {
      return data.title is string && data.title.size() > 0 && data.title.size() <= 80
        && validDate(data.date)
        && validTime(data.time)
        && data.category is string && data.category.size() <= 8
        && data.notes is string && data.notes.size() <= 300
        && validReminder(data.reminderMinutes)
        && data.reminderMethod in ['in-app', 'notification'];
    }

    function isValidCategory(categoryId) {
      let data = request.resource.data;
      return data.keys().hasAll(['id', 'uid', 'name'])
        && data.keys().hasOnly(['id', 'uid', 'name'])
        && validId(data, categoryId)
        && validUid(data)
        && data.name is string && data.name.size() > 0 && data.name.size() <= 8
        && categoryId.matches('^c_[0-9a-f]{2,64}$');
    }

    function isValidTask(taskId) {
      let data = request.resource.data;
      return data.keys().hasAll(['id', 'uid', 'title', 'date', 'time', 'category', 'notes', 'reminderMinutes', 'reminderMethod', 'priority', 'completed'])
        && data.keys().hasOnly(['id', 'uid', 'title', 'date', 'time', 'category', 'notes', 'reminderMinutes', 'reminderMethod', 'priority', 'completed'])
        && validId(data, taskId)
        && validUid(data)
        && validCommonFields(data)
        && data.priority in ['high', 'normal', 'low']
        && data.completed is bool;
    }

    function isValidEvent(eventId) {
      let data = request.resource.data;
      return data.keys().hasAll(['id', 'uid', 'title', 'date', 'time', 'endTime', 'category', 'notes', 'reminderMinutes', 'reminderMethod', 'location'])
        && data.keys().hasOnly(['id', 'uid', 'title', 'date', 'time', 'endTime', 'category', 'notes', 'reminderMinutes', 'reminderMethod', 'location'])
        && validId(data, eventId)
        && validUid(data)
        && validCommonFields(data)
        && validTime(data.endTime)
        && data.location is string && data.location.size() <= 160;
    }

    match /users/{userId}/categories/{categoryId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && uidUnchanged() && isValidCategory(categoryId);
      allow update: if isOwner(userId) && isDocOwner() && uidNotModified() && isValidCategory(categoryId);
      allow delete: if isOwner(userId) && isDocOwner();
    }

    match /users/{userId}/tasks/{taskId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && uidUnchanged() && isValidTask(taskId);
      allow update: if isOwner(userId) && isDocOwner() && uidNotModified() && isValidTask(taskId);
      allow delete: if isOwner(userId) && isDocOwner();
    }

    match /users/{userId}/events/{eventId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && uidUnchanged() && isValidEvent(eventId);
      allow update: if isOwner(userId) && isDocOwner() && uidNotModified() && isValidEvent(eventId);
      allow delete: if isOwner(userId) && isDocOwner();
    }

    // Deny every other collection and document by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
